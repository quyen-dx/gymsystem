# ====== APP ======

PORT=5000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# ====== DATABASE ======

MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>

# ====== AUTH ======

JWT_SECRET=<secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<secret>
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=<secret>

# ====== STORAGE ======

CLOUDINARY_CLOUD_NAME=<name>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<secret>

# ====== OAUTH ======

GOOGLE_CLIENT_ID=<id>
GOOGLE_CLIENT_SECRET=<secret>
FACEBOOK_APP_ID=<id>
FACEBOOK_APP_SECRET=<secret>

# ====== EMAIL ======

EMAIL_USER=<email>
EMAIL_PASS=<app-password>
# Display name shown as sender on all emails (default "GymPro"). Never shows the Gmail account name.
EMAIL_FROM_NAME=GymPro
# Optional explicit SMTP (STARTTLS on port 587). If unset, falls back to EMAIL_SERVICE || 'gmail' (port 465).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# EMAIL_SERVICE=gmail

# ====== SMS ======

ESMS_API_KEY=<key>
ESMS_SECRET_KEY=<secret>
SPEEDSMS_TOKEN=<token>

# ====== PAYMENT ======

STRIPE_SECRET_KEY=sk_test_<key>
STRIPE_WEBHOOK_SECRET=whsec_<secret>
VNPAY_TMN_CODE=<code>
VNPAY_HASH_SECRET=<secret>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/wallet/vnpay-return
EXCHANGE_RATE_API_KEY=<key>

# ====== URL ======

BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ====== AI ======

# -- Provider Selection ---
CHAT_PROVIDER=google
# CHAT_PROVIDER_ORDER=google,deepseek,openrouter
VISION_PROVIDER=google
EMBEDDING_PROVIDER=gemini
VECTOR_STORE=json
MEMORY_PROVIDER=memory

# -- Models ---
CHAT_MODEL=gemini-2.5-flash-lite
VISION_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# -- Provider Keys (one per provider, never reuse) ---
GEMINI_API_KEY=<your-gemini-key>
# DEEPSEEK_API_KEY=<your-deepseek-key>
# OPENROUTER_API_KEY=<your-openrouter-key>

# OPENAI_API_KEY=<your-openai-key>
# CLAUDE_API_KEY=<your-claude-key>
# AZURE_OPENAI_API_KEY=<your-azure-key>

# -- Memory ---
MEMORY_TTL=30

# -- Web Search ---
TAVILY_API_KEY=<your-tavily-key>

# ====== LEGACY ======

# GEMINI_API_KEY_ADMIN=<legacy-admin-key>
# TWILIO_ACCOUNT_SID=<sid>
# TWILIO_AUTH_TOKEN=<token>
# TWILIO_PHONE_NUMBER=<phone>

# AI-only configuration example.
# This demonstrates all supported providers in one place.
# Copy relevant sections into your main .env file.

# ====== Provider Selection ======
# Determines which provider handles each capability

CHAT_PROVIDER=google
# Options: google, deepseek, openai, claude, openrouter, azure

# CHAT_PROVIDER_ORDER=google,deepseek,openrouter
# When CHAT_PROVIDER=auto, try providers in order and use the first available

VISION_PROVIDER=google
# Options: google

EMBEDDING_PROVIDER=gemini
# Options: gemini, openai

VECTOR_STORE=json
# Options: json, mongodb, pinecone, qdrant, chroma

MEMORY_PROVIDER=memory
# Options: memory, redis, mongo

# ====== Models ======
# Provider-specific model names

CHAT_MODEL=gemini-2.5-flash-lite
# Google: gemini-2.5-flash-lite, gemini-2.5-pro
# DeepSeek: deepseek-chat, deepseek-reasoner
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4.1
# Claude: claude-sonnet-4-20250514, claude-opus-4-20250514

VISION_MODEL=gemini-2.5-flash-lite

EMBEDDING_MODEL=gemini-embedding-001
# Gemini: gemini-embedding-001 (3072 dim)
# OpenAI: text-embedding-3-small, text-embedding-3-large

# ====== Provider Keys ======
# Each provider has its own API key. Never reuse keys across providers.

# Google Gemini
GEMINI_API_KEY=<key>

# DeepSeek
# DEEPSEEK_API_KEY=sk-<key>

# OpenAI
# OPENAI_API_KEY=sk-<key>

# Anthropic Claude
# CLAUDE_API_KEY=sk-ant-<key>

# OpenRouter (proxy)
# OPENROUTER_API_KEY=sk-or-v1-<key>


# Azure OpenAI (enterprise)
# AZURE_OPENAI_API_KEY=<key>

# ====== Memory ======

MEMORY_TTL=30
# Minutes before session memory expires

# ====== Web Search ======

TAVILY_API_KEY=<key>

# ====== Switching Providers ======
#
# Example: Switch from Google to DeepSeek
#
# 1. Set CHAT_PROVIDER=deepseek (was google)
# 2. Set DEEPSEEK_API_KEY=sk-... (uncomment and fill)
# 3. Change CHAT_MODEL=deepseek-chat
#
# No code changes required. The facade handles provider loading.
